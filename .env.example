# App & Environment
APP=karavantruck-api-server
ENVIRONMENT=local
LOG_LEVEL=DEBUG

# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8090
SERVER_READ_TIMEOUT=5s
SERVER_WRITE_TIMEOUT=10s
SERVER_IDLE_TIMEOUT=120s

# Admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# Context
CONTEXT_TIMEOUT=30s

# Database
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=karavantruck
DB_USERNAME=postgres
DB_PASSWORD=
DB_SSLMODE=disable

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_ACCESS_SECRET=secret
JWT_REFRESH_SECRET=secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=670h

# Telegram OAuth 2.0
TELEGRAM_CLIENT_ID=
TELEGRAM_CLIENT_SECRET=
TELEGRAM_IOS_CLIENT_ID=
TELEGRAM_ANDROID_CLIENT_ID=

# OTLP / Observability
OTEL_SERVICE_NAME=karavantruck-api-server
OTEL_PROPAGATORS=baggage,tracecontext
OTEL_TRACES_EXPORTER=otlp
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_TRACES_SAMPLER=traceidratio
OTEL_TRACES_SAMPLER_ARG=1.0

# Public URLs
# Base origin of the public web app. Used to build shareable driver-invite
# links ({PUBLIC_APP_BASE_URL}/invite/{token}) and public cargo-tracking
# links ({PUBLIC_APP_BASE_URL}/track/{token}).
PUBLIC_APP_BASE_URL=https://app.yool.live

# Valhalla routing engine (map matching + A→B routes). No auth: private
# network only. Locally: ssh -N -L 8002:10.0.1.2:8002 root@135.181.20.92
VALHALLA_URL=http://localhost:8002
VALHALLA_TIMEOUT=30s

# Map matching of load tracks. Off by default: turn on together with (or
# after) the mobile release that records a point every 5 min while standing,
# otherwise stops look like gaps.
MATCHING_ENABLED=false
MATCHING_DEBOUNCE=60s
MATCHING_TIMEOUT=5m
MATCHING_GAP_THRESHOLD=10m
MATCHING_STOP_RADIUS_M=50
MATCHING_STOP_MIN_DURATION=10m
MATCHING_MAX_ACCURACY_M=50
MATCHING_RADIUS_MULTIPLIER=3
MATCHING_MIN_RADIUS_M=25
MATCHING_MAX_RADIUS_M=60
MATCHING_BREAKAGE_SPEED_MPS=25
MATCHING_BREAKAGE_FACTOR=1.5
MATCHING_MAX_REQUEST_DISTANCE_M=150000
